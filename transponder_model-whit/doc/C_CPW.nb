Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kCPW", "[", 
    RowBox[{"w_", ",", "g_"}], "]"}], ":=", " ", 
   FractionBox["w", 
    RowBox[{"w", "+", 
     RowBox[{"2", "g"}]}]]}], " ", 
